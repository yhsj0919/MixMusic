# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# Local archive of the v1 working tree.
/.v1-backup/
# Plugin source and demo packages belong in the separate plugin repository.
/assets/extensions/*

# Local attachments, temporary login images and release artifacts.
/.codex-remote-attachments/
/qq-login-temporary*.png
/dist/

# Signing credentials stay outside version control.
*.jks
*.keystore
